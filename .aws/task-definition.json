{
  "family": "multi-modal-perception-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::853169228724:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "multi-modal-perception-container",
      "image": "853169228724.dkr.ecr.us-east-2.amazonaws.com/multi-modal-perception-repo:latest",
      "essential": true,
  "secrets": [
    {
      "name": "OPENAI_API_KEY",
      "valueFrom": "arn:aws:secretsmanager:us-east-2:853169228724:secret:multi-modal-perception/openai-api-key-PQEayp"
    }
  ],
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/multi-modal-perception-task",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
